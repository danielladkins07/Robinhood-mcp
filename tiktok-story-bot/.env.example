# Copy this file to .env and fill it in (only needed when running on your own computer/server).

# From developers.tiktok.com -> your app
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in your TikTok app (Login Kit settings)
TIKTOK_REDIRECT_URI=https://your-site.example/callback

# Optional: lets the bot write new original stories when stories/ is empty
ANTHROPIC_API_KEY=

# PUBLIC_TO_EVERYONE works only after TikTok audits your app; until then it posts as SELF_ONLY
PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
HASHTAGS=#storytime #redditstories #fyp
# queue = only your stories/ files, ai = always write new ones, auto = queue first then AI
STORY_SOURCE=auto
# other voices: en-US-AriaNeural, en-US-GuyNeural, en-GB-RyanNeural
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+12%
MAX_SECONDS=170
